---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { projects } from '../../data/projects';
import type { Project } from '../../data/types';
import RepositoryLink from '../../components/RepositoryLink.astro';
export function getStaticPaths() { return projects.map(project => ({ params: { slug: project.slug }, props: { project } })); }
interface Props { project: Project; }
const { project } = Astro.props;
const next = projects[(projects.findIndex(item => item.slug === project.slug) + 1) % projects.length];
---
<SiteLayout title={project.title} description={project.summary}>
  <article class="case-study wrap"><a class="back-link" href="/projects/">← 返回项目</a><header class="case-heading"><p class="section-note">{project.category}</p><h1>{project.title}</h1><p class="case-summary">{project.summary}</p><div class="project-tags">{project.tags.map(tag => <span>{tag}</span>)}</div></header>
  {project.website && <div class="case-actions"><a class="button button-primary" href={project.website} target="_blank" rel="noopener noreferrer">访问 {project.title} 网站 <span aria-hidden="true">↗</span></a></div>}
  <div class="case-repository"><RepositoryLink name={project.repoName} label="查看源码" /></div>
  <figure class="case-cover"><img src={project.cover} alt={project.coverAlt} width="1440" height="900" fetchpriority="high" /></figure>
  <div class="case-body"><aside class="case-meta"><dl><div><dt>我的角色</dt><dd>{project.role}</dd></div><div><dt>当前状态</dt><dd>{project.status}</dd></div><div><dt>项目归属</dt><dd>{project.repoName}</dd></div></dl></aside><div class="case-content"><section><h2>为什么做</h2><p>{project.problem}</p></section><section><h2>如何实现</h2><ul>{project.approach.map(item => <li>{item}</li>)}</ul></section><section><h2>值得记录的部分</h2><ul>{project.highlights.map(item => <li>{item}</li>)}</ul></section><section class="case-boundaries"><h2>贡献与边界</h2><p>{project.boundaries}</p></section></div></div>
  {project.gallery && project.gallery.length > 0 && <section class="case-gallery" aria-label="项目画面">{project.gallery.map(item => <figure><img src={item.src} alt={item.alt} loading="lazy" width="1200" height="800" /><figcaption>{item.alt}</figcaption></figure>)}</section>}
  <a class="next-project" href={`/projects/${next.slug}/`}><span>继续看看</span><strong>{next.title}</strong><span aria-hidden="true">↗</span></a></article>
</SiteLayout>
