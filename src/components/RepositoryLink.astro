---
import { getRepository } from '../data/github';
interface Props { name: string; label?: string; }
const { name, label = 'GitHub' } = Astro.props;
const repository = getRepository(name);
---
{repository && <a class="repository-link" href={repository.url} target="_blank" rel="noopener noreferrer" aria-label={`${name} GitHub ${repository.private ? '私有仓库，需要访问权限，' : ''}新窗口打开`}><svg class="icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.64-1.33-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 6.83c.85 0 1.71.11 2.51.34 1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" /></svg><span>{label}</span>{repository.private && <small>私有仓库</small>}<span aria-hidden="true">↗</span></a>}
